# Copy to backend/.env for local development. Provider keys belong only in this
# backend file or the deployment platform's secret configuration.
# Local sentiment and replies work without any API key.
# Optional preferred provider: openai, anthropic, groq, gemini, or ollama
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# For local Ollama, set this to http://127.0.0.1:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=gemma3:1b
LLM_TIMEOUT_SECONDS=20
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_MESSAGE_CHARS=1000
